<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/item_detail_scroll_view_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_detail_item_close"
            android:layout_gravity="end|top"
            android:layout_margin="@dimen/item_detail_button_close_margin"
            android:background="@color/design_default_color_primary"
            android:textColor="@android:color/white"
            android:paddingHorizontal="@dimen/item_detail_button_close_padding_horizontal"
            android:paddingVertical="@dimen/item_detail_button_close_padding_vertical" />

        <TextView
            android:id="@+id/tvDetailDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="@dimen/item_detail_day_text_size" />

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="@dimen/item_detail_title_text_size"
            android:layout_marginTop="@dimen/item_detail_title_margin_top" />

        <ImageView
            android:id="@+id/ivDetailImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_detail_img_height"
            android:scaleType="centerCrop"
            android:layout_marginTop="@dimen/item_detail_img_margin_top" />

        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/item_detail_desc_text_size"
            android:layout_marginTop="@dimen/item_detail_desc_margin_top"
            android:lineSpacingMultiplier="1.2" />
    </LinearLayout>
</ScrollView>